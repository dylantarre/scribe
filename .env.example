# Configuration
# Set to 1 to enable automatic monitoring of channels
ENABLE_MONITORING=0

# Monitoring interval in seconds (default: 3600 = 1 hour)
MONITORING_INTERVAL=3600

# Channels to monitor (comma-separated list)
MONITOR_CHANNELS=@fantano,@theneedledrop

# Facebook reposting (0=off, 1=on)
FB_AUTO_REPOST=0

# Facebook Page settings
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Delay for non-Short videos before reposting (default: 86400 = 1 day)
FB_NORMAL_VIDEO_DELAY_SECONDS=86400

# If 1, Shorts will attempt upload as Reels first.
FB_SHORTS_AS_REELS=1

# Template for Facebook repost message.
# Available placeholders: {channel}, {title}, {description}, {url}
FB_REPOST_MESSAGE_TEMPLATE={title}

# Weekly classic reposts (popular all-time videos, no duplicates)
CLASSIC_AUTO_REPOST=0
CLASSIC_CHANNELS=@fantano,@theneedledrop
CLASSIC_POST_DAY=wednesday
CLASSIC_POST_HOUR=9
CLASSIC_POST_MINUTE=0
CLASSIC_POST_TZ=UTC
CLASSIC_TOP_CANDIDATES=50
CLASSIC_INCLUDE_SHORTS=0
